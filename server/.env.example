# SINAR Production Environment Configuration
# Copy this file to .env and fill in the values

# Database
POSTGRES_DB=sinar
POSTGRES_USER=sinar
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_THIS_TO_RANDOM_256BIT_KEY

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["https://sinar.tniad.mil.id"]

# File uploads
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=50

# AI yang dibayar per token (opsional). Tanpa baris ini PULSE memakai model lokal.
# AI_PROVIDER=grok
# XAI_API_KEY=
# XAI_MODEL=grok-4.7                           # menjawab Tanya AI, ringkasan, AI Insights
# XAI_BULK_MODEL=grok-4.20-0309-non-reasoning  # memberi label posting dan komentar
# PULSE_AI_HOSTED_BACKGROUND=false             # true: seluruh antrean analisis dikerjakan dengan token
# PULSE_AI_PARALLEL=8

# Threads lewat API resmi (opsional). Token jangan diketik: salin di browser lalu simpan dengan
#   pbpaste | ../.venv/bin/python -m app.pulse_threads_token
# THREADS_ACCESS_TOKEN=
# THREADS_APP_SECRET=                          # hanya untuk menukar token berumur pendek menjadi 60 hari

# Masa simpan posting (opsional). Posting yang lebih tua dari jumlah hari ini dihapus otomatis sekali sehari, bersama
# komentar, label, dan profil akunnya. Tanpa baris ini, atau dengan angka 0, tidak ada yang dihapus.
# Hitung dulu tanpa menghapus:  ../.venv/bin/python -m app.pulse_forget expired --days 365
# PULSE_RETENTION_DAYS=365
