{
  "about": [
    "Worked cases for the four readings of part 2 (coverage, term shift, hour grid, concentration), read by",
    "server/tests/test_pulse_readings.py and src/lib/pulseReadings.test.js. A change on one side fails the other.",
    "Posts: an entry with \"times\": n stands for n posts (an \"id\" gets -1, -2, ...; \"{i}\" in \"author\" becomes 01, 02, ...).",
    "Expected shares are written as fractions (\"3/11\") and compared as numbers. Hour-grid cells list only the hours that have posts."
  ],
  "zone": {"offset_minutes": 420, "name": "WIB"},
  "rules": [
    {"name": "coverage", "version": "coverage_v1", "text": "Cakupan data menyebut berapa bagian postingan dalam pilihan yang sudah dianalisis, yang interaksinya diketahui, dan yang membawa jam terbit; tingkatnya mengikuti bagian terkecil dari ketiganya: Lengkap mulai 90%, Cukup mulai 60%, Terbatas di bawah itu."},
    {"name": "term_shift", "version": "term_shift_v1", "text": "Naik dan turun kata membandingkan bagian postingan yang memuat satu kata, atau dua kata berurutan, pada periode ini dengan periode sama panjang tepat sebelumnya, dalam poin persentase; kata dihitung bila dimuat sedikitnya 5 postingan pada salah satu periode."},
    {"name": "hour_grid", "version": "hour_grid_v1", "text": "Kisi hari dan jam menghitung postingan yang membawa jam terbit per hari dan per jam menurut zona waktu instalasi; barisnya tanggal bila rentangnya 14 hari atau kurang, selain itu hari dalam seminggu mulai Senin."},
    {"name": "concentration", "version": "concentration_v1", "text": "Konsentrasi akun mengurutkan akun dari yang paling banyak memposting, lalu menyebut bagian postingan dari tiga akun teratas dan berapa akun yang dibutuhkan untuk mencapai 80% postingan; hal yang sama dihitung untuk interaksi, dari postingan yang interaksinya diketahui."}
  ],
  "stopwords": ["ada","adalah","adanya","adapun","agar","akan","akhirnya","aku","and","anda","antara","apa","apabila","apakah","are","atas","atau","awal","bagi","bahkan","bahwa","baik","banyak","baru","beberapa","begitu","belum","benar","berupa","bisa","bukan","cara","com","cukup","dalam","dan","dapat","dari","daripada","datang","demi","demikian","dengan","dia","dilakukan","diri","dirinya","dong","dua","dulu","for","from","hanya","harus","hingga","http","https","ia","ialah","id","ini","itu","jadi","jangan","juga","justru","kalau","kami","kamu","karena","kata","ke","kembali","kemudian","kepada","ketika","kita","kok","lagi","lain","lalu","lebih","maka","makin","masih","masing","maupun","melalui","memang","mengatakan","mengenai","menjadi","mereka","merupakan","meski","mungkin","namun","nanti","not","nya","oleh","pada","paling","para","perlu","pernah","pula","pun","punya","rt","saat","saja","saling","sama","sampai","sang","sangat","satu","saya","sebab","sebagai","sebagaimana","sebagainya","sebagian","sebelum","sebuah","secara","sedang","sehingga","sejak","sejumlah","sekitar","selalu","seluruh","semakin","sementara","semua","sendiri","seperti","serta","setiap","si","siapa","sudah","supaya","telah","tentang","tentu","terhadap","tersebut","tetapi","that","the","this","tiap","tidak","tiga","untuk","via","was","were","with","www","yaitu","yakni","yang","you","your"],
  "words": [
    {"note": "mixed case, and a repeated word stays repeated", "in": {"text": "BANJIR Banjir banjir"}, "out": ["banjir", "banjir", "banjir"]},
    {"note": "title first, then text", "in": {"title": "Banjir Jakarta", "text": "Warga mengungsi"}, "out": ["banjir", "jakarta", "warga", "mengungsi"]},
    {"note": "an accented letter is a letter, and a decomposed accent is composed first", "in": {"text": "Pel\u00e9 cafe\u0301 na\u00efve"}, "out": ["pel\u00e9", "caf\u00e9", "na\u00efve"]},
    {"note": "a mark that cannot be composed splits the word", "in": {"text": "x\u0301yz abc"}, "out": ["x", "yz", "abc"]},
    {"note": "digits split words and are never words", "in": {"text": "covid19 2024 h2o 3M"}, "out": ["covid", "h", "o", "m"]},
    {"note": "a hashtag is read as its letters, and an underscore splits it", "in": {"text": "#MakanSiangGratis #makan_siang"}, "out": ["makansianggratis", "makan", "siang"]},
    {"note": "a mention is removed whole, also when it names a site", "in": {"text": "@budi_santoso halo @Kompas.com"}, "out": ["halo"]},
    {"note": "links are removed whole, with or without a scheme", "in": {"text": "baca https://contoh.id/berita-banjir?x=1 dan www.contoh.id/abc atau contoh.co.id/kabar-kota selesai"}, "out": ["baca", "dan", "atau", "selesai"]},
    {"note": "an e-mail address is removed, and so is anything written word@word", "in": {"text": "hubungi redaksi@contoh.id atau kasih@budi sekarang"}, "out": ["hubungi", "atau", "sekarang"]},
    {"note": "two words joined by a full stop are read as a site name and removed", "in": {"text": "banjir.Warga mengungsi"}, "out": ["mengungsi"]},
    {"note": "emoji and punctuation separate words", "in": {"text": "banjir\ud83c\udf0abesar, parah!"}, "out": ["banjir", "besar", "parah"]},
    {"note": "markup is dropped and entities are read as text", "in": {"text": "<b>Banjir</b>&nbsp;besar &amp; parah<script>alert('x')</script> &lt;i&gt;sekali&lt;/i&gt;"}, "out": ["banjir", "besar", "parah", "sekali"]},
    {"note": "numeric entities, and one that names no character", "in": {"text": "&#98;anjir &#x42;ESAR &#0;x &#9999999999;"}, "out": ["banjir", "besar", "x"]},
    {"note": "full-width letters are folded to plain ones", "in": {"text": "\uff22\uff21\uff2e\uff2a\uff29\uff32 \uff42\uff45\uff53\uff41\uff52"}, "out": ["banjir", "besar"]},
    {"note": "a capital sigma at the end of a word becomes the final form", "in": {"text": "\u039f\u0394\u039f\u03a3"}, "out": ["\u03bf\u03b4\u03bf\u03c2"]},
    {"note": "a dotted capital I leaves a mark behind when lower-cased, which splits the word", "in": {"text": "\u0130stanbul"}, "out": ["i", "stanbul"]},
    {"note": "letters outside the first plane are letters", "in": {"text": "\ud800\udf30\ud800\udf31 warga"}, "out": ["\ud800\udf30\ud800\udf31", "warga"]},
    {"note": "a no-break space ends a link", "in": {"text": "https://contoh.id\u00a0banjir"}, "out": ["banjir"]},
    {"note": "a zero-width no-break space ends a link too", "in": {"text": "https://contoh.id\ufeffbanjir"}, "out": ["banjir"]},
    {"note": "a next-line control does not end a link", "in": {"text": "https://contoh.id\u0085banjir warga"}, "out": ["warga"]},
    {"note": "a field that is not text is skipped", "in": {"title": null, "text": 12}, "out": []},
    {"note": "a post without text", "in": {}, "out": []}
  ],
  "terms": [
    {"note": "words of 3 to 40 characters that are not stop words, and each two of them in a row", "in": {"text": "Makan siang gratis"}, "out": ["makan", "siang", "gratis", "makan siang", "siang gratis"]},
    {"note": "a stop word is not a term and breaks the pair", "in": {"text": "banjir yang besar"}, "out": ["banjir", "besar"]},
    {"note": "a short word breaks the pair too", "in": {"text": "banjir di kota"}, "out": ["banjir", "kota"]},
    {"note": "punctuation, digits, emoji and a removed link do not break the pair", "in": {"text": "banjir, 2026 \ud83c\udf0a https://x.id/a besar"}, "out": ["banjir", "besar", "banjir besar"]},
    {"note": "a repeated word counts once, and a word followed by itself is a pair", "in": {"text": "banjir banjir banjir"}, "out": ["banjir", "banjir banjir"]},
    {"note": "a pair never runs from the title into the text", "in": {"title": "Banjir Jakarta", "text": "Warga mengungsi"}, "out": ["banjir", "jakarta", "warga", "mengungsi", "banjir jakarta", "warga mengungsi"]},
    {"note": "length is counted as the browser counts it: two letters outside the first plane are long enough", "in": {"text": "\ud800\udf30\ud800\udf31 warga"}, "out": ["\ud800\udf30\ud800\udf31", "warga", "\ud800\udf30\ud800\udf31 warga"]},
    {"note": "a word of 40 letters is kept, one of 41 is not", "in": {"text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}, "out": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]},
    {"note": "a post without text has no terms", "in": {}, "out": []}
  ],
  "period_before": [
    {"note": "a week", "from": "2026-11-09", "to": "2026-11-15", "out": {"from": "2026-11-02", "to": "2026-11-08"}},
    {"note": "one day", "from": "2026-11-10", "to": "2026-11-10", "out": {"from": "2026-11-09", "to": "2026-11-09"}},
    {"note": "across a year", "from": "2026-01-01", "to": "2026-01-31", "out": {"from": "2025-12-01", "to": "2025-12-31"}},
    {"note": "into a leap day", "from": "2028-03-01", "to": "2028-03-01", "out": {"from": "2028-02-29", "to": "2028-02-29"}},
    {"note": "no chosen period", "from": null, "to": null, "out": null},
    {"note": "only a start is not a period", "from": "2026-11-09", "to": null, "out": null},
    {"note": "only an end is not a period", "from": null, "to": "2026-11-15", "out": null},
